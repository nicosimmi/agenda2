{
  "name": "agendia",
  "private": true,
  "version": "0.0.0",
  "description": "Marketplace de reservas con asistente de IA y servidor MCP",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "pnpm -r --if-present build",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "eval": "pnpm --filter @agendia/evals eval"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<0.25.0": ">=0.25.0",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "fast-uri@>=4.0.0 <4.2.3": "4.2.3",
      "body-parser@>=2.0.0 <2.4.0": "2.4.0",
      "ip-address@<10.7.4": ">=10.7.4",
      "qs@<6.16.1": ">=6.16.1"
    }
  }
}
