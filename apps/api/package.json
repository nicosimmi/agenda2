{
  "name": "@agendia/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "node --watch --env-file=../../.env src/server.ts",
    "start": "node --env-file=../../.env src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=../../.env src/db/migrate.ts",
    "db:seed": "node --env-file=../../.env src/db/seed.ts"
  },
  "dependencies": {
    "@agendia/core": "workspace:*",
    "@agendia/shared": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@node-rs/argon2": "2.2.1",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
