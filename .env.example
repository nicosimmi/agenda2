# Copia este fichero a .env (cp .env.example .env). .env está en .gitignore: nunca lo subas.
# Los valores de aquí son SOLO para desarrollo local.

# --- PostgreSQL ---
POSTGRES_USER=agendia
POSTGRES_PASSWORD=cambia-esto-en-local
POSTGRES_DB=agendia
POSTGRES_PORT=5432

# --- Mailpit (correo de desarrollo) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- n8n ---
N8N_PORT=5678
GENERIC_TIMEZONE=Europe/Madrid

# --- Fase 6 en adelante (aún no se usan) ---
