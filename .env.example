# Copia este fichero a .env (cp .env.example .env). .env está en .gitignore: nunca lo subas.
# Los valores de aquí son SOLO para desarrollo local.

# --- PostgreSQL ---
POSTGRES_USER=agendia
POSTGRES_PASSWORD=cambia-esto-en-local
POSTGRES_DB=agendia
POSTGRES_PORT=5433

# --- API ---
API_PORT=3000
# Orígenes de la web que pueden usar la sesión (CORS y CSRF), separados por comas
WEB_ORIGIN=http://localhost:5173
# IP o CIDR de los proxies inversos de confianza, separados por comas (vacío en local). Necesario
# para que el rate limiting vea la IP real del cliente al desplegar detrás de un proxy.
TRUSTED_PROXIES=

# --- Mailpit (correo de desarrollo) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- n8n ---
N8N_PORT=5678
GENERIC_TIMEZONE=Europe/Madrid

# --- Automatizaciones (Fase 7) ---
# Secreto compartido con n8n para firmar las peticiones (HMAC). Inventa uno largo y distinto en
# cada entorno: `openssl rand -hex 32`. Con N8N_WEBHOOK_BASE vacío, la API no entrega avisos.
AUTOMATION_SECRET=
N8N_WEBHOOK_BASE=http://localhost:5678/webhook

# --- Agente de IA (Fase 6) ---
# ANTHROPIC_API_KEY va SOLO aquí, nunca como variable global del sistema.
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# low | medium | high: low basta para reservar y es lo más barato
# LLM_EFFORT=low
# Topes de gasto diarios en EUR: global, por persona y por chat
# LLM_DAILY_BUDGET_EUR=2
# LLM_USER_DAILY_BUDGET_EUR=0.5
# LLM_SESSION_BUDGET_EUR=0.2
# Precios por millón de tokens (EUR) para estimar el gasto; ajústalos a la tarifa vigente
# LLM_PRICE_IN_EUR_PER_MTOK=3.7
# LLM_PRICE_OUT_EUR_PER_MTOK=18.5
# Guion de demostración sin clave ni gasto (no es un modelo; nunca en producción)
# LLM_PROVIDER=demo

# Servidor MCP (apps/mcp-server)
# stdio: AGENDIA_API_URL y AGENDIA_TOKEN (el token se genera en la web, en «Mis reservas»)
AGENDIA_API_URL=http://localhost:3000
# HTTP: puerto y dirección de escucha, y orígenes de navegador permitidos (por defecto, ninguno)
MCP_PORT=3200
MCP_HOST=127.0.0.1
MCP_ALLOWED_ORIGINS=
